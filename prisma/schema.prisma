// ═══════════════════════════════════════════════════════
//  SHIKKHALOY — Database Schema (ক্যানোনিকাল)
//  Phase 1 ✅ | Phase 2: Enrollment + StudentProfile + Shift
//                  + StaffProfile + TeacherAssignment
//  Source of Truth: এই ফাইলটাই (নীতি ১৩)
// ═══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 🏬 ব্রাঞ্চ (মাল্টি-ব্রাঞ্চ সাপোর্টের ভিত্তি) ───
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  sessions           AcademicSession[]
  shifts             Shift[]
  gradingScales      GradingScale[]
  departments        Department[]
  classes            AcademicClass[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
}

// ─── 👤 ইউজার (নীতি ১: কখনো DELETE না — status বদলাবে) ───
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)
  branchId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branch             Branch             @relation(fields: [branchId], references: [id])
  enrollments        Enrollment[]
  studentProfile     StudentProfile?
  staffProfile       StaffProfile?
  teacherAssignments TeacherAssignment[]

  @@index([branchId])
  @@index([role])
  @@index([status])
}

// ─── 📅 একাডেমিক সেশন (২.৫: একাধিক, ১টি সক্রিয়; ডুপ-চেক অ্যাপ-লেভেলে) ───
model AcademicSession {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]

  @@index([branchId])
}

// ─── ⏰ শিফট (২.৫ — সমান্তরাল তালিকা; শুধু ব্রাঞ্চের সাথে যুক্ত) ───
model Shift {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startTime String?   // HH:MM
  endTime   String?   // HH:MM (end > start)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([branchId])
}

// ─── 🔖 Enums ───
enum Role {
  PLATFORM_SUPER_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  STAFF
  ALUMNI
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ALUMNI
}

// ─── ⚙️ প্রতিষ্ঠান সেটিংস (সিঙ্গলটন — key="global") ───
model InstitutionSetting {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  nameEn     String?
  tagline    String?
  taglineEn  String?
  brandColor String    @default("#4f46e5")
  eiin       String?
  address    String?
  phone      String?
  email      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// ─── 🎯 গ্রেডিং (নীতি ৯: branchId প্রথম দিন থেকেই) ───
model GradingScale {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  rules     GradeRule[]
  classes   AcademicClass[]

  @@index([branchId])
}

model GradeRule {
  id        String       @id @default(cuid())
  scaleId   String
  scale     GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade     String
  minMarks  Float
  maxMarks  Float
  point     Float
  isPassed  Boolean      @default(true)
  sortOrder Int          @default(0)

  @@index([scaleId])
}

// ─── 🏛️ একাডেমিক কাঠামো ───
model Department {
  id        String          @id @default(cuid())
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  code      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  classes   AcademicClass[]

  @@index([branchId])
}

model AcademicClass {
  id             String        @id @default(cuid())
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  gradingScaleId String?
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id])
  name           String
  nameEn         String?
  numericLevel   Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  sections       Section[]
  subjects       Subject[]
  enrollments    Enrollment[]
  teacherAssignments TeacherAssignment[]

  @@index([branchId])
  @@index([departmentId])
}

model Section {
  id        String        @id @default(cuid())
  classId   String
  class     AcademicClass @relation(fields: [classId], references: [id])
  name      String
  capacity  Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]

  @@index([classId])
}

model Subject {
  id          String        @id @default(cuid())
  classId     String
  class       AcademicClass @relation(fields: [classId], references: [id])
  name        String
  nameEn      String?
  code        String?
  creditHours Float         @default(1)
  isElective  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  teacherAssignments TeacherAssignment[]

  @@index([classId])
}

// ─── 🎓 ভর্তি (নীতি ২: অ্যাকাউন্ট ≠ ভর্তি-রেকর্ড) ───
model Enrollment {
  id            String           @id @default(cuid())
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  studentId     String
  student       User             @relation(fields: [studentId], references: [id])
  classId       String
  klass         AcademicClass    @relation(fields: [classId], references: [id]) // 'class' সংরক্ষিত শব্দ — তাই klass
  sectionId     String?
  section       Section?         @relation(fields: [sectionId], references: [id])
  sessionId     String?
  session       AcademicSession? @relation(fields: [sessionId], references: [id])
  rollNumber    Int?
  status        String           @default("ACTIVE") // ACTIVE/COMPLETED/TRANSFERRED/DROPPED
  admissionDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([classId])
  @@index([studentId])
}

// ─── 🧑‍🎓 শিক্ষার্থী-প্রোফাইল (২.৪ — User ১:১, ১৮ ফিল্ড) ───
model StudentProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  photoUrl              String?
  dateOfBirth           DateTime?
  gender                String?
  bloodGroup            String?
  fatherName            String?
  motherName            String?
  guardianPhone         String?
  address               String?
  birthCertificateNo    String?
  studentPhone          String?
  nationality           String?
  religion              String?
  previousInstitution   String?
  previousQualification String?
  guardianRelation      String?
  guardianOccupation    String?
  guardianNid           String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
}

// ─── 👩‍🏫 স্টাফ-প্রোফাইল (২.৬ — User ১:১) ───
model StaffProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  photoUrl      String?
  designation   String?
  qualification String?
  phone         String?
  joiningDate   DateTime?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── 📚 শিক্ষক-অ্যাসাইনমেন্ট (২.৬ — রুটিন/অ্যাটেনডেন্স/মার্কসের ভিত) ───
model TeacherAssignment {
  id        String        @id @default(cuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id])
  teacherId String
  teacher   User          @relation(fields: [teacherId], references: [id])
  classId   String
  klass     AcademicClass @relation(fields: [classId], references: [id])
  sectionId String?
  section   Section?      @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject       @relation(fields: [subjectId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([branchId])
  @@index([teacherId])
}
