// ═══════════════════════════════════════════
//  SHIKKHALOY — Database Schema v0.1
//  Phase 1: Branch, User, AcademicSession
// ═══════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 🏬 ব্রাঞ্চ (মাল্টি-ব্রাঞ্চ সাপোর্টের ভিত্তি) ───
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  sessions AcademicSession[]
  gradingScales GradingScale[]

  departments Department[]
  classes     AcademicClass[]
  enrollments Enrollment[]


}

// ─── 👤 ইউজার (স্টুডেন্ট/টিচার/অ্যাডমিন — সবাই এখানেই) ───
// নীতি: অ্যাকাউন্ট কখনো DELETE হবে না, শুধু status বদলাবে
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)
  branchId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([role])
  @@index([status])
  enrollments Enrollment[]
}

// ─── 📅 একাডেমিক সেশন (যেমন: ২০২৫-২৬) ───
model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([name, branchId])
  enrollments Enrollment[]
}

// ─── 🔖 Enums ───
enum Role {
  PLATFORM_SUPER_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  STAFF
  ALUMNI
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ALUMNI
}

// ═══════════ প্রতিষ্ঠান সেটিংস (সিঙ্গলটন — সিস্টেমে ১টাই রো, key="global") ═══════════
model InstitutionSetting {
  id         String    @id @default(cuid())
  key        String    @unique // সিঙ্গলটন গ্যারান্টি — সবসময় "global"
  name       String    // প্রতিষ্ঠানের নাম (বাংলা)
  nameEn     String?   // নাম (ইংরেজি)
  tagline    String?   // ট্যাগলাইন (বাংলা)
  taglineEn  String?   // ট্যাগলাইন (ইংরেজি)
  brandColor String    @default("#4f46e5") // ব্র্যান্ড কালার (hex)
  eiin       String?   // EIIN / প্রতিষ্ঠান কোড
  address    String?
  phone      String?
  email      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // Soft Delete (নীতি ৪)
}

// ═══════════ গ্রেডিং সিস্টেম (নীতি ৯: branchId প্রথম দিন থেকেই) ═══════════
model GradingScale {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String    // স্কেলের নাম (যেমন: GPA 5.00 বাংলাদেশ স্ট্যান্ডার্ড)
  nameEn    String?
  isActive  Boolean   @default(true) // প্রতি ব্রাঞ্চে একটাই অ্যাক্টিভ (MVP)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // স্কেল নিজে Soft Delete (নীতি ৪)
  rules     GradeRule[]

  @@index([branchId])
  classes AcademicClass[]

}

model GradeRule {
  id        String       @id @default(cuid())
  scaleId   String
  scale     GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade     String       // A+, A, A-, B, C, D, F...
  minMarks  Float        // রেঞ্জের শুরু (0–100)
  maxMarks  Float        // রেঞ্জের শেষ
  point     Float        // গ্রেড পয়েন্ট (0–5)
  isPassed  Boolean      @default(true) // F = false
  sortOrder Int          @default(0)    // দেখানোর ক্রম

  @@index([scaleId])
}

// ═══════════ একাডেমিক কাঠামো (নীতি ৯: branchId সব টেবিলে) ═══════════
model Department {
  id        String          @id @default(cuid())
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  name      String          // যেমন: কম্পিউটার সায়েন্স (ভার্সিটি) / বিজ্ঞান (স্কুল)
  nameEn    String?
  code      String?         // CSE, SCI
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  classes   AcademicClass[]

  @@index([branchId])
}

model AcademicClass {
  id             String        @id @default(cuid())
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  gradingScaleId String?       // null = ব্রাঞ্চের সক্রিয় স্কেল (১.১২-এর বাঁধাই!)
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id])
  name           String        // ষষ্ঠ শ্রেণী / BSc CSE — সেমিস্টার ১
  nameEn         String?
  numericLevel   Int?          // স্কুল: ৬,৭,৮...; ভার্সিটি: সেমিস্টার নম্বর — প্রমোশনে কাজে লাগবে
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  sections       Section[]
  subjects       Subject[]

  @@index([branchId])
  @@index([departmentId])
  enrollments Enrollment[]
}

model Section {
  id        String        @id @default(cuid())
  classId   String
  class     AcademicClass @relation(fields: [classId], references: [id])
  name      String        // ক / A / Morning
  capacity  Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([classId])
  enrollments Enrollment[]
}

model Subject {
  id          String        @id @default(cuid())
  classId     String
  class       AcademicClass @relation(fields: [classId], references: [id])
  name        String        // গণিত / Introduction to Programming
  nameEn      String?
  code        String?       // MATH-101
  creditHours Float         @default(1) // ভার্সিটির GPA-ওজনে (ফেজ ৩) কাজে লাগবে
  isElective  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([classId])
}

// ═══════════ ভর্তি (নীতি ২: অ্যাকাউন্ট ≠ ভর্তি-রেকর্ড) ═══════════
model Enrollment {
  id            String           @id @default(cuid())
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  studentId     String
  student       User             @relation(fields: [studentId], references: [id])
  classId       String
  klass         AcademicClass    @relation(fields: [classId], references: [id]) // 'class' সংরক্ষিত শব্দ — তাই klass
  sectionId     String?
  section       Section?         @relation(fields: [sectionId], references: [id])
  sessionId     String?          // AcademicSession UI আসলে ভরা হবে (ফেজ ২)
  session       AcademicSession? @relation(fields: [sessionId], references: [id])
  rollNumber    Int?
  status        String           @default("ACTIVE") // ACTIVE/COMPLETED/TRANSFERRED/DROPPED
  admissionDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([classId])
  @@index([studentId])
}




