// ═══════════════════════════════════════════════════════
//  SHIKKHALOY — Database Schema (ক্যানোনিকাল)
//  Phase 1-2 ✅ | 3.1 Attendance ✅ | 3.2 Leave ✅ | 3.3 RoutineSlot 🆕
//  Source of Truth: এই ফাইলটাই (নীতি ১৩)
// ═══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 🏬 ব্রাঞ্চ ───
model Branch {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  address    String?
  phone      String?
  email      String?
  logoUrl    String?
  brandColor String? // 🆕 M13-E4 — null = প্রতিষ্ঠানের-ডিফল্ট (InstitutionSetting.brandColor)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users              User[]
  sessions           AcademicSession[]
  shifts             Shift[]
  gradingScales      GradingScale[]
  departments        Department[]
  classes            AcademicClass[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  leaveApplications  LeaveApplication[]
  routineSlots       RoutineSlot[]
  exams              Exam[]
  classrooms         Classroom[]
  routineBreaks      RoutineBreak[]
  marks              Mark[]
}


// ─── 👤 ইউজার (নীতি ১) ───
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)
  branchId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branch             Branch              @relation(fields: [branchId], references: [id])
  enrollments        Enrollment[]
  studentProfile     StudentProfile?
  staffProfile       StaffProfile?
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]        @relation("AttendanceStudent")
  markedAttendances  Attendance[]        @relation("AttendanceMarker")
  leaveApplications  LeaveApplication[]  @relation("LeaveStudent")
  decidedLeaves      LeaveApplication[]  @relation("LeaveDecider")
  routineSlots       RoutineSlot[]       @relation("RoutineTeacher")
  marks              Mark[]
  enteredMarks       Mark[]              @relation("MarkEnteredBy")

  @@index([branchId])
  @@index([role])
  @@index([status])
}

// ─── 📅 একাডেমিক সেশন ───
model AcademicSession {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]

  @@index([branchId])
}

// ─── ⏰ শিফট ───
model Shift {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startTime String?
  endTime   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([branchId])
}

// ─── 🔖 Enums ───
enum Role {
  PLATFORM_SUPER_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  STAFF
  ALUMNI
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ALUMNI
}

// ─── ⚙️ প্রতিষ্ঠান সেটিংস ───
model InstitutionSetting {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  nameEn     String?
  tagline    String?
  taglineEn  String?
  brandColor String    @default("#4f46e5")
  logoUrl    String?
  heroImages String[]  @default([]) // 🆕 M14-E1 — হিরো-স্লাইডারের ক্যাম্পাস-ছবি; খালি = ডিজাইন-ব্যানার
  eiin       String?
  address    String?
  phone      String?
  email      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// ─── 🎯 গ্রেডিং ───
model GradingScale {
  id        String          @id @default(cuid())
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  rules     GradeRule[]
  classes   AcademicClass[]

  @@index([branchId])
}

model GradeRule {
  id        String       @id @default(cuid())
  scaleId   String
  scale     GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade     String
  minMarks  Float
  maxMarks  Float
  point     Float
  isPassed  Boolean      @default(true)
  sortOrder Int          @default(0)

  @@index([scaleId])
}

// ─── 🏛️ একাডেমিক কাঠামো ───
model Department {
  id        String          @id @default(cuid())
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  code      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  classes   AcademicClass[]

  @@index([branchId])
}

model AcademicClass {
  id                 String              @id @default(cuid())
  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id])
  departmentId       String?
  department         Department?         @relation(fields: [departmentId], references: [id])
  gradingScaleId     String?
  gradingScale       GradingScale?       @relation(fields: [gradingScaleId], references: [id])
  name               String
  nameEn             String?
  numericLevel       Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  sections           Section[]
  subjects           Subject[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  leaveApplications  LeaveApplication[]
  routineSlots       RoutineSlot[]
  routineBreaks      RoutineBreak[]
  questions          Question[]

  @@index([branchId])
  @@index([departmentId])
}

model Section {
  id                 String              @id @default(cuid())
  classId            String
  class              AcademicClass       @relation(fields: [classId], references: [id])
  name               String
  capacity           Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  leaveApplications  LeaveApplication[]
  routineSlots       RoutineSlot[]

  @@index([classId])
}

model Subject {
  id                 String              @id @default(cuid())
  classId            String
  class              AcademicClass       @relation(fields: [classId], references: [id])
  name               String
  nameEn             String?
  code               String?
  creditHours        Float               @default(1)
  isElective         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  teacherAssignments TeacherAssignment[]
  routineSlots       RoutineSlot[]       @relation("RoutineSubject")
  examSubjects       ExamSubject[]
  questions          Question[]

  @@index([classId])
}

// ─── 🎓 ভর্তি (নীতি ২) ───
model Enrollment {
  id            String           @id @default(cuid())
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  studentId     String
  student       User             @relation(fields: [studentId], references: [id])
  classId       String
  klass         AcademicClass    @relation(fields: [classId], references: [id])
  sectionId     String?
  section       Section?         @relation(fields: [sectionId], references: [id])
  sessionId     String?
  session       AcademicSession? @relation(fields: [sessionId], references: [id])
  rollNumber    Int?
  status        String           @default("ACTIVE")
  admissionDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([classId])
  @@index([studentId])
}

// ─── 🧑‍🎓 শিক্ষার্থী-প্রোফাইল ───
model StudentProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  photoUrl              String?
  dateOfBirth           DateTime?
  gender                String?
  bloodGroup            String?
  fatherName            String?
  motherName            String?
  guardianPhone         String?
  address               String?
  birthCertificateNo    String?
  studentPhone          String?
  nationality           String?
  religion              String?
  previousInstitution   String?
  previousQualification String?
  guardianRelation      String?
  guardianOccupation    String?
  guardianNid           String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
}

// ─── 👩‍🏫 স্টাফ-প্রোফাইল ───
model StaffProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  photoUrl      String?
  designation   String?
  qualification String?
  phone         String?
  joiningDate   DateTime?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── 📚 শিক্ষক-অ্যাসাইনমেন্ট ───
model TeacherAssignment {
  id           String        @id @default(cuid())
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  teacherId    String
  teacher      User          @relation(fields: [teacherId], references: [id])
  classId      String
  klass        AcademicClass @relation(fields: [classId], references: [id])
  sectionId    String?
  section      Section?      @relation(fields: [sectionId], references: [id])
  subjectId    String
  subject      Subject       @relation(fields: [subjectId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  routineSlots RoutineSlot[]

  @@index([branchId])
  @@index([teacherId])
}

// ─── ✅ অ্যাটেনডেন্স (৩.১) ───
model Attendance {
  id         String        @id @default(cuid())
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  studentId  String
  student    User          @relation("AttendanceStudent", fields: [studentId], references: [id])
  classId    String
  klass      AcademicClass @relation(fields: [classId], references: [id])
  sectionId  String?
  section    Section?      @relation(fields: [sectionId], references: [id])
  date       DateTime      @db.Date
  status     String // PRESENT/ABSENT/LEAVE
  method     String        @default("manual") // manual/qr/rfid/face — নীতি ৪
  note       String?
  markedById String
  markedBy   User          @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@unique([studentId, date])
  @@index([branchId, date])
  @@index([classId, date])
}

// ─── 📝 ছুটির আবেদন (৩.২) ───
model LeaveApplication {
  id          String        @id @default(cuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  studentId   String
  student     User          @relation("LeaveStudent", fields: [studentId], references: [id])
  classId     String
  klass       AcademicClass @relation(fields: [classId], references: [id])
  sectionId   String?
  section     Section?      @relation(fields: [sectionId], references: [id])
  fromDate    DateTime      @db.Date
  toDate      DateTime      @db.Date
  reason      String
  status      String        @default("PENDING") // PENDING/APPROVED/REJECTED
  decidedById String?
  decidedBy   User?         @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([branchId, status])
  @@index([studentId])
}

// ─── 🗓️ রুটিন-স্লট (৩.৩ — assignment-ভিত্তিক + স্ন্যাপশট-কলাম) ───
model RoutineSlot {
  id           String            @id @default(cuid())
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  assignmentId String
  assignment   TeacherAssignment @relation(fields: [assignmentId], references: [id])
  teacherId    String // স্ন্যাপশট — টিচার-কনফ্লিক্ট কুয়েরির জন্য
  teacher      User              @relation("RoutineTeacher", fields: [teacherId], references: [id])
  subjectId    String // স্ন্যাপশট
  subject      Subject           @relation("RoutineSubject", fields: [subjectId], references: [id])
  classId      String // স্ন্যাপশট
  klass        AcademicClass     @relation(fields: [classId], references: [id])
  sectionId    String? // null = পুরো ক্লাস দখল করে
  section      Section?          @relation(fields: [sectionId], references: [id])
  classroomId  String? // ৩.৪ — কক্ষ-কনফ্লিক্টের চাবি (ঐচ্ছিক)
  classroom    Classroom?        @relation(fields: [classroomId], references: [id])

  day       Int // ০=শনি … ৬=শুক্র
  period    Int // ১..৮ (MVP fixed)
  room      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([assignmentId, day, period]) // exact-dup DB-লেভেলে বন্ধ
  @@index([branchId])
  @@index([classId, day, period])
  @@index([teacherId, day, period])
  @@index([classroomId, day, period])
}

// ─── 🏫 ক্লাসরুম (৩.৪ — রুটিনের কক্ষ-কনফ্লিক্টের উৎস) ───
model Classroom {
  id           String        @id @default(cuid())
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  name         String
  capacity     Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  routineSlots RoutineSlot[]

  @@index([branchId])
}

// ─── 📝 এক্সাম (৩.৫ — অফলাইন; রুটিন=ExamSubject; মার্কস ৩.৬-এ যুক্ত হবে) ───
model Exam {
  id        String        @id @default(cuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  examType  String        @default("FINAL") // FIRST_TERM/HALF_YEARLY/FINAL/TEST/MODEL/OTHER
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    String        @default("UPCOMING") // UPCOMING/ONGOING/COMPLETED
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  subjects  ExamSubject[]
  marks     Mark[]

  @@index([branchId])
}

model ExamSubject {
  id        String    @id @default(cuid())
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  examDate  DateTime  @db.Date
  startTime String?
  endTime   String?
  fullMarks Float     @default(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  marks     Mark[]

  @@index([examId])
}

// ─── 🍚 রুটিন-বিরতি (৩.৩.৩ — classId: null=ব্রাঞ্চ-সাধারণ; সেট=ক্লাস-নিজস্ব পূর্ণ-ওভাররাইড) ───
model RoutineBreak {
  id        String         @id @default(cuid())
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id])
  classId   String?
  class     AcademicClass? @relation(fields: [classId], references: [id])
  period    Int // ১..৮
  label     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([branchId, classId, period]) // classId=null ডুপ DB-রোগ নয় — API findFirst দিয়ে আটকায়
  @@index([branchId])
}

// ─── 🖊️ মার্কস (৩.৬ — grade-স্ন্যাপশট; upsert=পুনঃএন্ট্রি-নিরাপদ; নোট ৪০) ───
model Mark {
  id            String      @id @default(cuid())
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id])
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  studentId     String
  student       User        @relation(fields: [studentId], references: [id])
  marksObtained Float
  grade         String?
  gradePoint    Float?
  enteredById   String
  enteredBy     User        @relation("MarkEnteredBy", fields: [enteredById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@unique([examSubjectId, studentId])
  @@index([branchId])
  @@index([examId])
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT
  LONG
}

model Question {
  id         String       @id @default(cuid())
  subjectId  String
  classId    String?
  type       QuestionType @default(MCQ)
  text       String
  options    Json?
  answer     String?
  marks      Float        @default(1)
  difficulty String       @default("MEDIUM")
  chapter    String?
  imageUrl   String?
  tags       String[]     @default([])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  subject Subject        @relation(fields: [subjectId], references: [id])
  class   AcademicClass? @relation(fields: [classId], references: [id])

  @@index([subjectId])
}

// ─── ৪.৪ অনলাইন এক্সাম ইঞ্জিন (নোট ৫৫: scalar-FK — পুরনো মডেল স্পর্শ নেই)
enum OnlineExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model OnlineExam {
  id          String           @id @default(cuid())
  branchId    String
  classId     String
  subjectId   String
  createdById String
  title       String
  durationMin Int              @default(30)
  startTime   DateTime
  endTime     DateTime
  randomize   Boolean          @default(true)
  status      OnlineExamStatus @default(DRAFT)
  examKind    String           @default("EXAM") // 🆕 M9: EXAM/QUIZ
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  questions OnlineExamQuestion[]
  attempts  ExamAttempt[]

  @@index([branchId, status])
}


model OnlineExamQuestion {
  id       String       @id @default(cuid())
  examId   String
  order    Int          @default(0)
  type     QuestionType
  text     String
  options  Json?
  answer   String?
  marks    Float        @default(1)
  imageUrl String?

  exam OnlineExam @relation(fields: [examId], references: [id])
}

model ExamAttempt {
  id            String    @id @default(cuid())
  examId        String
  studentId     String
  questionOrder String    @default("[]")
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  status        String    @default("IN_PROGRESS")
  totalMarks    Float     @default(0)
  obtainedMarks Float     @default(0)

  exam    OnlineExam   @relation(fields: [examId], references: [id]) // ← এই লাইনটাই ছিল না (P1012)
  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
}

model ExamAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  examQuestionId String
  response       String?
  marksObtained  Float?

  attempt ExamAttempt @relation(fields: [attemptId], references: [id])

  @@unique([attemptId, examQuestionId])
}

// ─── ৪.৬ ফি-মডিউল (নোট ৫৫: scalar-FK অ্যাপেন্ড; রিলেশন-জুটি সব ব্লকের ভেতরে — ৫৫(ক))
model FeeStructure {
  id        String    @id @default(cuid())
  branchId  String
  classId   String
  name      String
  nameEn    String?
  amount    Float
  monthKey  String? // "2026-01" = মাসিক ফি; null = এককালীন
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoices FeeInvoice[]

  @@index([branchId])
  @@index([classId])
}

model FeeInvoice {
  id          String    @id @default(cuid())
  branchId    String
  structureId String
  studentId   String
  classId     String
  amount      Float
  dueDate     DateTime?
  status      String    @default("UNPAID") // UNPAID/PARTIAL/PAID
  paidTotal   Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  structure FeeStructure @relation(fields: [structureId], references: [id])
  payments  FeePayment[]

  @@unique([structureId, studentId])
  @@index([branchId])
  @@index([studentId])
  @@index([classId])
}

model FeePayment {
  id           String    @id @default(cuid())
  branchId     String
  invoiceId    String
  amount       Float
  method       String    @default("CASH") // CASH/BKASH/BANK/OTHER
  note         String?
  receivedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([branchId])
}

// ─── P2-DOC স্টুডেন্ট-ডকুমেন্ট + হেলথ-রেকর্ড (নোট ৫৫: scalar-FK অ্যাপেন্ড; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য)
model StudentDocument {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String
  title        String
  docType      String    @default("OTHER") // BIRTH_CERT/ACADEMIC/PHOTO/OTHER
  fileUrl      String
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId])
  @@index([studentId])
}

model HealthRecord {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String
  date         DateTime  @db.Date
  type         String // CHECKUP/VACCINATION/ILLNESS/INJURY/ALLERGY/OTHER
  title        String
  note         String?
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId])
  @@index([studentId])
}


// ─── M2: অনলাইন ভর্তি আবেদন (scalar-FK অ্যাপেন্ড — নোট ৫৫)
model AdmissionApplication {
  id                  String    @id @default(cuid())
  applicationNo       String    @unique
  branchId            String
  classId             String
  sectionId           String?
  sessionId           String?
  fullName            String
  email               String
  phone               String
  dateOfBirth         DateTime? @db.Date
  gender              String?
  fatherName          String?
  motherName          String?
  guardianPhone       String?
  address             String?
  previousInstitution String?
  photoUrl            String?
  status              String    @default("PENDING") // PENDING/APPROVED/REJECTED
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([branchId])
  @@index([status])
}


// ─── M3: PARENT-সন্তান লিংক (scalar-FK অ্যাপেন্ড — নোট ৫৫)
model ParentLink {
  id          String    @id @default(cuid())
  branchId    String
  parentId    String
  studentId   String
  relation    String? // FATHER/MOTHER/GUARDIAN/OTHER
  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@unique([parentId, studentId])
  @@index([branchId])
  @@index([studentId])
}

// ─── M6: QR হাজিরা-সেশন (scalar-FK অ্যাপেন্ড — নোট ৫৫)
model AttendanceQrSession {
  id          String   @id @default(cuid())
  branchId    String
  classId     String
  sectionId   String?
  date        DateTime @db.Date
  nonce       String   @unique
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([branchId, date])
  @@index([classId, date])
}

// ─── M7: অনলাইন-পেমেন্ট-ইনটেন্ট (৪.৭-B — scalar-FK অ্যাপেন্ড — নোট ৫৫)
model PaymentIntent {
  id            String    @id @default(cuid())
  branchId      String
  invoiceId     String
  studentId     String
  amount        Float
  tranId        String    @unique
  valId         String?
  gatewayTxnId  String?
  cardBrand     String?
  status        String    @default("PENDING") // PENDING/SUCCESS/FAILED
  initiatedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([invoiceId])
  @@index([status])
}


// ─── M10: অ্যাসাইনমেন্ট + সাবমিশন (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-জুটি ব্লকের-ভেতরেই)
model Assignment {
  id          String    @id @default(cuid())
  branchId    String
  classId     String
  subjectId   String
  createdById String
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Float     @default(10)
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  submissions AssignmentSubmission[]

  @@index([branchId])
  @@index([classId, dueDate])
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  branchId      String
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  studentId     String
  fileUrl       String
  note          String?
  submittedAt   DateTime   @default(now())
  isLate        Boolean    @default(false)
  marksObtained Float?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  @@unique([assignmentId, studentId])
  @@index([branchId])
  @@index([studentId])
}

// ─── M11: ডিসকাউন্ট/স্কলারশিপ + Income-Expense Ledger (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য)
model StudentDiscount {
  id          String    @id @default(cuid())
  branchId    String
  studentId   String
  name        String
  type        String    @default("PERCENT") // PERCENT/AMOUNT
  value       Float
  isActive    Boolean   @default(true)
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId])
  @@index([studentId])
}

model LedgerEntry {
  id          String    @id @default(cuid())
  branchId    String
  type        String // INCOME/EXPENSE
  category    String
  amount      Float
  date        DateTime  @db.Date
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId, type])
  @@index([branchId, date])
}

// ─── M12: স্যালারি (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য; upsert — নোট ৩৬)
model SalaryStructure {
  id          String    @id @default(cuid())
  branchId    String
  userId      String
  amount      Float
  isActive    Boolean   @default(true)
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([userId])
  @@index([branchId])
}

model SalaryRecord {
  id            String    @id @default(cuid())
  branchId      String
  userId        String
  monthKey      String // "2026-11"
  baseAmount    Float
  bonus         Float     @default(0)
  deduction     Float     @default(0)
  netAmount     Float
  status        String    @default("PENDING") // PENDING/PAID
  paidAt        DateTime?
  method        String?
  note          String?
  ledgerEntryId String? // M11-অটো-ব্যয়-রেফারেন্স
  paidById      String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([userId, monthKey])
  @@index([branchId, monthKey])
}

// ─── M13-A: নোটিশ + ইভেন্ট + নোটিফিকেশন (scalar-FK অ্যাপেন্ড — নোট ৫৫)
model Notice {
  id            String    @id @default(cuid())
  branchId      String
  title         String
  body          String
  audience      String    @default("ALL") // ALL/STUDENT/TEACHER/PARENT/STAFF
  isPinned      Boolean   @default(false)
  isPublic      Boolean   @default(false) // 🆕 M14-E1 — সত্যি = পাবলিক-ওয়েবসাইটে দৃশ্যমান
  fileUrl       String?
  publishedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([branchId, createdAt])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  branchId    String
  title       String
  description String?
  date        DateTime @db.Date
  type        String   @default("EVENT") // HOLIDAY/EXAM/EVENT/MEETING
  isPublic    Boolean  @default(false) // 🆕 M14-E1 — সত্যি = পাবলিক-ওয়েবসাইটে দৃশ্যমান
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([branchId, date])
}


model AppNotification {
  id        String   @id @default(cuid())
  branchId  String
  userId    String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([userId, isRead])
  @@index([branchId])
}

// ─── M13-B: মেসেজিং (scalar-FK অ্যাপেন্ড — নোট ৫৫; threadId = রুট-মেসেজের-নিজের-id — নোট ৮১)
model Message {
  id          String    @id @default(cuid())
  branchId    String
  threadId    String    @default("")
  broadcastId String? // একই-ব্রডকাস্ট = এক-কী (sent-গ্রুপিং)
  senderId    String
  recipientId String
  subject     String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId, threadId])
  @@index([recipientId, readAt])
  @@index([senderId])
}

// ─── M13-C: ডকুমেন্ট ইঞ্জিন (scalar-FK অ্যাপেন্ড — নোট ৫৫; ভেরিফিকেশন-পোর্টাল = পরের-চেকবক্স)
model Document {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String
  type         String    @default("CERTIFICATE") // TC/CERTIFICATE/MARKSHEET/TRANSCRIPT
  docNo        String    @unique // ADM-প্যাটার্ন: DOC-YYYY-XXXXXX
  verifyCode   String    @unique // QR-চাবি (random) — পোর্টাল-যাচাই + REVOKED-প্রদর্শন
  title        String
  payload      Json?     // ইস্যু-মুহূর্তের-স্ন্যাপশট (নাম/শ্রেণি/মার্কস — পরে-ডেটা-বদললেও-ডকুমেন্ট-ভাঙে-না)
  status       String    @default("ACTIVE") // ACTIVE/REVOKED
  revokedAt    DateTime?
  revokeReason String?
  issuedById   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId, type])
  @@index([studentId])
}

// ─── M13-D1: ডুপ্লিকেট-ডকুমেন্ট রিকোয়েস্ট (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য)
model DocumentRequest {
  id            String    @id @default(cuid())
  branchId      String
  studentId     String    // যে-ছাত্রের-জন্য ডকুমেন্ট
  requestedById String    // কে-চেয়েছে (STUDENT-নিজে / PARENT)
  type          String    // TC/CERTIFICATE/MARKSHEET/TRANSCRIPT — Document.type-হুবহু
  reason        String
  status        String    @default("PENDING") // PENDING/APPROVED/REJECTED/ISSUED
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  documentId    String?   // ইস্যুর-পরে নতুন-Document-এর-id
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([branchId, status])
  @@index([studentId])
}

// ─── M13-D2: স্টাডি ম্যাটেরিয়াল + হোমওয়ার্ক-ডায়েরি + সিলেবাস-ট্র্যাকিং (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য)
model StudyMaterial {
  id          String    @id @default(cuid())
  branchId    String
  classId     String
  subjectId   String
  title       String
  description String?
  fileUrl     String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId])
  @@index([classId, subjectId])
}

model HomeworkDiary {
  id          String    @id @default(cuid())
  branchId    String
  classId     String
  subjectId   String
  date        DateTime  @db.Date
  task        String
  dueDate     DateTime? @db.Date
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([classId, subjectId, date]) // এক-দিন-এক-বিষয়-এক-এন্ট্রি → upsert=last-write-wins (নোট ৩৬)
  @@index([branchId, date])
  @@index([classId, subjectId])
}

model SyllabusProgress {
  id          String    @id @default(cuid())
  branchId    String
  classId     String
  subjectId   String
  date        DateTime  @db.Date
  chapter     String
  topic       String?
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId])
  @@index([classId, subjectId])
}


// ─── M14-A: লাইব্রেরি (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য; নাম = findMany+Map)
model LibraryBook {
  id          String    @id @default(cuid())
  branchId    String
  title       String
  author      String?
  isbn        String?
  category    String?
  copiesTotal Int       @default(1)
  shelfCode   String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId])
}

model BookLoan {
  id          String    @id @default(cuid())
  branchId    String
  bookId      String
  studentId   String
  issueDate   DateTime  @db.Date
  dueDate     DateTime  @db.Date
  returnDate  DateTime? @db.Date
  status      String    @default("ISSUED") // ISSUED/RETURNED
  fine        Float     @default(0)
  issuedById  String
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId, status])
  @@index([bookId])
  @@index([studentId])
}


// ─── M14-B: হোস্টেল + ট্রান্সপোর্ট (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই; প্রাপ্যতা = groupBy-গণনা — নোট ৯৩)
model HostelRoom {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  type        String    @default("BOYS") // BOYS/GIRLS/COMMON
  capacity    Int       @default(4)
  monthlyFee  Float     @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([branchId, name])
  @@index([branchId])
}

model HostelAllocation {
  id            String    @id @default(cuid())
  branchId      String
  roomId        String
  studentId     String
  status        String    @default("ACTIVE") // ACTIVE/VACATED
  vacatedAt     DateTime?
  allocatedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([studentId]) // এক-শিক্ষার্থী-এক-রেকর্ড → পুনঃবরাদ্দ = upsert (ভূত-নিরাপদ — নোট ৩৬)
  @@index([branchId, status])
}

model TransportRoute {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  stops       String? // কমা-বিভাজিত স্টপ
  vehicleNo   String?
  capacity    Int       @default(30)
  monthlyFee  Float     @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([branchId, name])
  @@index([branchId])
}

model TransportAllocation {
  id            String    @id @default(cuid())
  branchId      String
  routeId       String
  studentId     String
  stopName      String?
  status        String    @default("ACTIVE") // ACTIVE/VACATED
  vacatedAt     DateTime?
  allocatedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([studentId])
  @@index([branchId, status])
}


// ─── M14-C: ক্লাব + ইনভেন্টরি (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই; স্টক = txn-সমষ্টি-গণনা — নোট ৯৩)
model Club {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  description String?
  advisor     String? // দায়িত্বশীল-শিক্ষক (ঐচ্ছিক, টেক্সট)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([branchId, name])
  @@index([branchId])
}

model ClubMembership {
  id          String    @id @default(cuid())
  branchId    String
  clubId      String
  studentId   String
  status      String    @default("ACTIVE") // ACTIVE/LEFT
  leftAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([clubId, studentId]) // এক-ক্লাবে-এক-সদস্য-রেকর্ড → পুনঃযোগ = upsert (ভূত-নিরাপদ — নোট ৩৬)
  @@index([branchId, status])
}

model InventoryItem {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  category    String?
  unit        String? // পিস/সেট/লিটার…
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([branchId, name])
  @@index([branchId])
}

model InventoryTxn {
  id          String   @id @default(cuid())
  branchId    String
  itemId      String
  type        String // IN/OUT
  qty         Int
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([branchId])
  @@index([itemId])
}


// ─── M14-D: ভিজিটর-লগ (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই; status-কলাম-নেই — INSIDE/CHECKED_OUT = checkOutAt-derived — নোট ৯৬)
model VisitorLog {
  id           String    @id @default(cuid())
  branchId     String
  name         String
  phone        String?
  personToMeet String?
  purpose      String?
  checkInAt    DateTime  @default(now())
  checkOutAt   DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId, checkInAt])
}

// ─── M14-E2: অ্যালামনাই-প্রোফাইল (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য; নাম = findMany+Map — নোট ৯০)
model AlumniProfile {
  id                String    @id @default(cuid())
  branchId          String
  userId            String    @unique // এক-মানুষ-এক-প্রোফাইল → লেখা = ভূত-নিরাপদ upsert (নোট ৩৬)
  batch             String?   // "2020" / "HSC 2018" — প্রতিষ্ঠান-নিজস্ব-লেবেল
  profession        String?
  organization      String?
  bio               String?
  linkedinUrl       String?
  isDirectoryPublic Boolean   @default(false) // true = পাবলিক /alumni-ডিরেক্টরিতে দৃশ্যমান
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([branchId])
  @@index([isDirectoryPublic])
}

// ─── M14-H1: অডিট-লগ (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য; নাম = findMany+Map — নোট ৯০)
// অপরিবর্তনীয়-খাতা: updatedAt/deletedAt-ই-নেই — অডিট কখনো-সম্পাদনা/মুছে-নয় (নীতি-৩-এর-স্থায়ী-ব্যতিক্রম)
model AuditLog {
  id        String   @id @default(cuid())
  branchId  String?  // null = প্ল্যাটফর্ম-স্তরের-কাজ (ব্রাঞ্চ-বহির্ভূত)
  actorId   String?  // null = সিস্টেম
  action    String   // LOGIN/LOGIN_FAIL/CREATE/UPDATE/DELETE/RESTORE/APPROVE/REJECT/PAY/ISSUE/REVOKE/RESET
  entity    String   // User/AdmissionApplication/FeePayment/Document/...
  entityId  String?
  summary   String?  // মানুষ-পাঠযোগ্য এক-লাইন
  meta      Json?    // প্রেক্ষাপট-স্ন্যাপশট — ⚠️ পাসওয়ার্ড/টোকেন/PII-কখনো-নয়
  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
// ─── M14-I: হেল্পডেস্ক-টিকিট (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য; নাম = findMany+Map)
model HelpDeskTicket {
  id          String    @id @default(cuid())
  branchId    String
  creatorId   String // User.id — যেকোনো-সক্রিয়-রোল
  assigneeId  String? // User.id — ডায়ালগে-অ্যাডমিন
  ticketNo    String    @unique // HD-YYYY-XXXXX
  title       String
  category    String // ACADEMIC/FEE/TECH/OTHER
  priority    String // LOW/MEDIUM/HIGH
  status      String    @default("OPEN") // OPEN/IN_PROGRESS/RESOLVED/CLOSED
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId, status])
  @@index([creatorId, createdAt])
}

model HelpDeskReply {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([ticketId, createdAt])
}

// ═══ M14-L: ছাত্র-ছুটির-আবেদন (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-জুটি-নেই) ═══
model StudentLeave {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String    // User.id (STUDENT) — scalar-FK (৫৫)
  classId      String    // স্ন্যাপশট = আবেদন-মুহূর্তের-সক্রিয়-ভর্তি (৩২-প্যাটার্ন)
  sectionId    String?
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId, status])
  @@index([studentId, status])
}


// ─── M15-C: স্টাফ-হাজিরা (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য) ───
model StaffAttendance {
  id         String   @id @default(cuid())
  branchId   String
  userId     String // TEACHER/ACCOUNTANT/STAFF/BRANCH_ADMIN — ছাত্র-নয়
  date       DateTime @db.Date
  status     String // PRESENT/ABSENT/LEAVE
  note       String?
  markedById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@unique([userId, date]) // পুনঃসংরক্ষণ = upsert (নোট ৩৬)
  @@index([branchId, date])
}


// ─── M16-A: স্টাফ-মডিউল-অনুমতি (config-join — hard-row; নোট ৩৮-দর্শন; scalar-FK — নোট ৫৫) ───
model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  permKey     String
  grantedById String
  createdAt   DateTime @default(now())

  @@unique([userId, permKey])
  @@index([userId])
}
