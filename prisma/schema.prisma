// ═══════════════════════════════════════════════════════
//  SHIKKHALOY — Database Schema (ক্যানোনিকাল)
//  Phase 1-2 ✅ | Phase 3.1: Attendance 🆕
//  Source of Truth: এই ফাইলটাই (নীতি ১৩)
// ═══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 🏬 ব্রাঞ্চ ───
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  sessions           AcademicSession[]
  shifts             Shift[]
  gradingScales      GradingScale[]
  departments        Department[]
  classes            AcademicClass[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
}

// ─── 👤 ইউজার (নীতি ১) ───
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)
  branchId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branch             Branch             @relation(fields: [branchId], references: [id])
  enrollments        Enrollment[]
  studentProfile     StudentProfile?
  staffProfile       StaffProfile?
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]       @relation("AttendanceStudent")
  markedAttendances  Attendance[]       @relation("AttendanceMarker")

  @@index([branchId])
  @@index([role])
  @@index([status])
}

// ─── 📅 একাডেমিক সেশন ───
model AcademicSession {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]

  @@index([branchId])
}

// ─── ⏰ শিফট ───
model Shift {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startTime String?
  endTime   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([branchId])
}

// ─── 🔖 Enums ───
enum Role {
  PLATFORM_SUPER_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  STAFF
  ALUMNI
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ALUMNI
}

// ─── ⚙️ প্রতিষ্ঠান সেটিংস ───
model InstitutionSetting {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  nameEn     String?
  tagline    String?
  taglineEn  String?
  brandColor String    @default("#4f46e5")
  eiin       String?
  address    String?
  phone      String?
  email      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// ─── 🎯 গ্রেডিং ───
model GradingScale {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  rules     GradeRule[]
  classes   AcademicClass[]

  @@index([branchId])
}

model GradeRule {
  id        String       @id @default(cuid())
  scaleId   String
  scale     GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade     String
  minMarks  Float
  maxMarks  Float
  point     Float
  isPassed  Boolean      @default(true)
  sortOrder Int          @default(0)

  @@index([scaleId])
}

// ─── 🏛️ একাডেমিক কাঠামো ───
model Department {
  id        String          @id @default(cuid())
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  code      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  classes   AcademicClass[]

  @@index([branchId])
}

model AcademicClass {
  id             String        @id @default(cuid())
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  gradingScaleId String?
  gradingScale   GradingScale? @relation(fields: [gradingScaleId], references: [id])
  name           String
  nameEn         String?
  numericLevel   Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  sections       Section[]
  subjects       Subject[]
  enrollments    Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances    Attendance[]

  @@index([branchId])
  @@index([departmentId])
}

model Section {
  id        String        @id @default(cuid())
  classId   String
  class     AcademicClass @relation(fields: [classId], references: [id])
  name      String
  capacity  Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]

  @@index([classId])
}

model Subject {
  id          String        @id @default(cuid())
  classId     String
  class       AcademicClass @relation(fields: [classId], references: [id])
  name        String
  nameEn      String?
  code        String?
  creditHours Float         @default(1)
  isElective  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  teacherAssignments TeacherAssignment[]

  @@index([classId])
}

// ─── 🎓 ভর্তি (নীতি ২) ───
model Enrollment {
  id            String           @id @default(cuid())
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  studentId     String
  student       User             @relation(fields: [studentId], references: [id])
  classId       String
  klass         AcademicClass    @relation(fields: [classId], references: [id])
  sectionId     String?
  section       Section?         @relation(fields: [sectionId], references: [id])
  sessionId     String?
  session       AcademicSession? @relation(fields: [sessionId], references: [id])
  rollNumber    Int?
  status        String           @default("ACTIVE")
  admissionDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([classId])
  @@index([studentId])
}

// ─── 🧑‍🎓 শিক্ষার্থী-প্রোফাইল ───
model StudentProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  photoUrl              String?
  dateOfBirth           DateTime?
  gender                String?
  bloodGroup            String?
  fatherName            String?
  motherName            String?
  guardianPhone         String?
  address               String?
  birthCertificateNo    String?
  studentPhone          String?
  nationality           String?
  religion              String?
  previousInstitution   String?
  previousQualification String?
  guardianRelation      String?
  guardianOccupation    String?
  guardianNid           String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
}

// ─── 👩‍🏫 স্টাফ-প্রোফাইল ───
model StaffProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  photoUrl      String?
  designation   String?
  qualification String?
  phone         String?
  joiningDate   DateTime?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── 📚 শিক্ষক-অ্যাসাইনমেন্ট ───
model TeacherAssignment {
  id        String        @id @default(cuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id])
  teacherId String
  teacher   User          @relation(fields: [teacherId], references: [id])
  classId   String
  klass     AcademicClass @relation(fields: [classId], references: [id])
  sectionId String?
  section   Section?      @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject       @relation(fields: [subjectId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@index([branchId])
  @@index([teacherId])
}

// ─── ✅ অ্যাটেনডেন্স (৩.১ — দৈনিক; নীতি ৪: method; নীতি ৫: markedBy=অডিট) ───
model Attendance {
  id         String        @id @default(cuid())
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  studentId  String
  student    User          @relation("AttendanceStudent", fields: [studentId], references: [id])
  classId    String
  klass      AcademicClass @relation(fields: [classId], references: [id])
  sectionId  String?       // স্ন্যাপশট — কোন মোডে (সেকশন/পুরো-ক্লাস) নেওয়া হয়েছিল
  section    Section?      @relation(fields: [sectionId], references: [id])
  date       DateTime      @db.Date
  status     String        // PRESENT/ABSENT/LEAVE
  method     String        @default("manual") // manual/qr/rfid/face — নীতি ৪
  note       String?
  markedById String
  markedBy   User          @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@unique([studentId, date]) // এক শিক্ষার্থী = দিনে এক রেকর্ড; upsert = পুনঃসংরক্ষণ নিরাপদ
  @@index([branchId, date])
  @@index([classId, date])
}
