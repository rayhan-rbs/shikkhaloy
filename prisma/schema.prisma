// ═══════════════════════════════════════════════════════
//  SHIKKHALOY — Database Schema (ক্যানোনিকাল)
//  Phase 1-2 ✅ | 3.1 Attendance ✅ | 3.2 Leave ✅ | 3.3 RoutineSlot 🆕
//  Source of Truth: এই ফাইলটাই (নীতি ১৩)
// ═══════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 🏬 ব্রাঞ্চ ───
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  sessions           AcademicSession[]
  shifts             Shift[]
  gradingScales      GradingScale[]
  departments        Department[]
  classes            AcademicClass[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  leaveApplications  LeaveApplication[]
  routineSlots       RoutineSlot[]
  exams              Exam[]
  classrooms         Classroom[]
  routineBreaks      RoutineBreak[]
  marks              Mark[]
}

// ─── 👤 ইউজার (নীতি ১) ───
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  fullName     String
  phone        String?
  avatarUrl    String?
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  isFirstLogin Boolean    @default(true)
  branchId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branch             Branch              @relation(fields: [branchId], references: [id])
  enrollments        Enrollment[]
  studentProfile     StudentProfile?
  staffProfile       StaffProfile?
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]        @relation("AttendanceStudent")
  markedAttendances  Attendance[]        @relation("AttendanceMarker")
  leaveApplications  LeaveApplication[]  @relation("LeaveStudent")
  decidedLeaves      LeaveApplication[]  @relation("LeaveDecider")
  routineSlots       RoutineSlot[]       @relation("RoutineTeacher")
  marks              Mark[]
  enteredMarks       Mark[]              @relation("MarkEnteredBy")

  @@index([branchId])
  @@index([role])
  @@index([status])
}

// ─── 📅 একাডেমিক সেশন ───
model AcademicSession {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startDate DateTime
  endDate   DateTime
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]

  @@index([branchId])
}

// ─── ⏰ শিফট ───
model Shift {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  startTime String?
  endTime   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([branchId])
}

// ─── 🔖 Enums ───
enum Role {
  PLATFORM_SUPER_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  STAFF
  ALUMNI
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ALUMNI
}

// ─── ⚙️ প্রতিষ্ঠান সেটিংস ───
model InstitutionSetting {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  nameEn     String?
  tagline    String?
  taglineEn  String?
  brandColor String    @default("#4f46e5")
  logoUrl    String?
  eiin       String?
  address    String?
  phone      String?
  email      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

// ─── 🎯 গ্রেডিং ───
model GradingScale {
  id        String          @id @default(cuid())
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  rules     GradeRule[]
  classes   AcademicClass[]

  @@index([branchId])
}

model GradeRule {
  id        String       @id @default(cuid())
  scaleId   String
  scale     GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade     String
  minMarks  Float
  maxMarks  Float
  point     Float
  isPassed  Boolean      @default(true)
  sortOrder Int          @default(0)

  @@index([scaleId])
}

// ─── 🏛️ একাডেমিক কাঠামো ───
model Department {
  id        String          @id @default(cuid())
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  code      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  classes   AcademicClass[]

  @@index([branchId])
}

model AcademicClass {
  id                 String              @id @default(cuid())
  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id])
  departmentId       String?
  department         Department?         @relation(fields: [departmentId], references: [id])
  gradingScaleId     String?
  gradingScale       GradingScale?       @relation(fields: [gradingScaleId], references: [id])
  name               String
  nameEn             String?
  numericLevel       Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  sections           Section[]
  subjects           Subject[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  leaveApplications  LeaveApplication[]
  routineSlots       RoutineSlot[]
  routineBreaks      RoutineBreak[]
  questions          Question[]

  @@index([branchId])
  @@index([departmentId])
}

model Section {
  id                 String              @id @default(cuid())
  classId            String
  class              AcademicClass       @relation(fields: [classId], references: [id])
  name               String
  capacity           Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  leaveApplications  LeaveApplication[]
  routineSlots       RoutineSlot[]

  @@index([classId])
}

model Subject {
  id                 String              @id @default(cuid())
  classId            String
  class              AcademicClass       @relation(fields: [classId], references: [id])
  name               String
  nameEn             String?
  code               String?
  creditHours        Float               @default(1)
  isElective         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  teacherAssignments TeacherAssignment[]
  routineSlots       RoutineSlot[]       @relation("RoutineSubject")
  examSubjects       ExamSubject[]
  questions          Question[]

  @@index([classId])
}

// ─── 🎓 ভর্তি (নীতি ২) ───
model Enrollment {
  id            String           @id @default(cuid())
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  studentId     String
  student       User             @relation(fields: [studentId], references: [id])
  classId       String
  klass         AcademicClass    @relation(fields: [classId], references: [id])
  sectionId     String?
  section       Section?         @relation(fields: [sectionId], references: [id])
  sessionId     String?
  session       AcademicSession? @relation(fields: [sessionId], references: [id])
  rollNumber    Int?
  status        String           @default("ACTIVE")
  admissionDate DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([classId])
  @@index([studentId])
}

// ─── 🧑‍🎓 শিক্ষার্থী-প্রোফাইল ───
model StudentProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  photoUrl              String?
  dateOfBirth           DateTime?
  gender                String?
  bloodGroup            String?
  fatherName            String?
  motherName            String?
  guardianPhone         String?
  address               String?
  birthCertificateNo    String?
  studentPhone          String?
  nationality           String?
  religion              String?
  previousInstitution   String?
  previousQualification String?
  guardianRelation      String?
  guardianOccupation    String?
  guardianNid           String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
}

// ─── 👩‍🏫 স্টাফ-প্রোফাইল ───
model StaffProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  photoUrl      String?
  designation   String?
  qualification String?
  phone         String?
  joiningDate   DateTime?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── 📚 শিক্ষক-অ্যাসাইনমেন্ট ───
model TeacherAssignment {
  id           String        @id @default(cuid())
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  teacherId    String
  teacher      User          @relation(fields: [teacherId], references: [id])
  classId      String
  klass        AcademicClass @relation(fields: [classId], references: [id])
  sectionId    String?
  section      Section?      @relation(fields: [sectionId], references: [id])
  subjectId    String
  subject      Subject       @relation(fields: [subjectId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  routineSlots RoutineSlot[]

  @@index([branchId])
  @@index([teacherId])
}

// ─── ✅ অ্যাটেনডেন্স (৩.১) ───
model Attendance {
  id         String        @id @default(cuid())
  branchId   String
  branch     Branch        @relation(fields: [branchId], references: [id])
  studentId  String
  student    User          @relation("AttendanceStudent", fields: [studentId], references: [id])
  classId    String
  klass      AcademicClass @relation(fields: [classId], references: [id])
  sectionId  String?
  section    Section?      @relation(fields: [sectionId], references: [id])
  date       DateTime      @db.Date
  status     String // PRESENT/ABSENT/LEAVE
  method     String        @default("manual") // manual/qr/rfid/face — নীতি ৪
  note       String?
  markedById String
  markedBy   User          @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  @@unique([studentId, date])
  @@index([branchId, date])
  @@index([classId, date])
}

// ─── 📝 ছুটির আবেদন (৩.২) ───
model LeaveApplication {
  id          String        @id @default(cuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  studentId   String
  student     User          @relation("LeaveStudent", fields: [studentId], references: [id])
  classId     String
  klass       AcademicClass @relation(fields: [classId], references: [id])
  sectionId   String?
  section     Section?      @relation(fields: [sectionId], references: [id])
  fromDate    DateTime      @db.Date
  toDate      DateTime      @db.Date
  reason      String
  status      String        @default("PENDING") // PENDING/APPROVED/REJECTED
  decidedById String?
  decidedBy   User?         @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([branchId, status])
  @@index([studentId])
}

// ─── 🗓️ রুটিন-স্লট (৩.৩ — assignment-ভিত্তিক + স্ন্যাপশট-কলাম) ───
model RoutineSlot {
  id           String            @id @default(cuid())
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  assignmentId String
  assignment   TeacherAssignment @relation(fields: [assignmentId], references: [id])
  teacherId    String // স্ন্যাপশট — টিচার-কনফ্লিক্ট কুয়েরির জন্য
  teacher      User              @relation("RoutineTeacher", fields: [teacherId], references: [id])
  subjectId    String // স্ন্যাপশট
  subject      Subject           @relation("RoutineSubject", fields: [subjectId], references: [id])
  classId      String // স্ন্যাপশট
  klass        AcademicClass     @relation(fields: [classId], references: [id])
  sectionId    String? // null = পুরো ক্লাস দখল করে
  section      Section?          @relation(fields: [sectionId], references: [id])
  classroomId  String? // ৩.৪ — কক্ষ-কনফ্লিক্টের চাবি (ঐচ্ছিক)
  classroom    Classroom?        @relation(fields: [classroomId], references: [id])

  day       Int // ০=শনি … ৬=শুক্র
  period    Int // ১..৮ (MVP fixed)
  room      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([assignmentId, day, period]) // exact-dup DB-লেভেলে বন্ধ
  @@index([branchId])
  @@index([classId, day, period])
  @@index([teacherId, day, period])
  @@index([classroomId, day, period])
}

// ─── 🏫 ক্লাসরুম (৩.৪ — রুটিনের কক্ষ-কনফ্লিক্টের উৎস) ───
model Classroom {
  id           String        @id @default(cuid())
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  name         String
  capacity     Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  routineSlots RoutineSlot[]

  @@index([branchId])
}

// ─── 📝 এক্সাম (৩.৫ — অফলাইন; রুটিন=ExamSubject; মার্কস ৩.৬-এ যুক্ত হবে) ───
model Exam {
  id        String        @id @default(cuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id])
  name      String
  nameEn    String?
  examType  String        @default("FINAL") // FIRST_TERM/HALF_YEARLY/FINAL/TEST/MODEL/OTHER
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    String        @default("UPCOMING") // UPCOMING/ONGOING/COMPLETED
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  subjects  ExamSubject[]
  marks     Mark[]

  @@index([branchId])
}

model ExamSubject {
  id        String    @id @default(cuid())
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  examDate  DateTime  @db.Date
  startTime String?
  endTime   String?
  fullMarks Float     @default(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  marks     Mark[]

  @@index([examId])
}

// ─── 🍚 রুটিন-বিরতি (৩.৩.৩ — classId: null=ব্রাঞ্চ-সাধারণ; সেট=ক্লাস-নিজস্ব পূর্ণ-ওভাররাইড) ───
model RoutineBreak {
  id        String         @id @default(cuid())
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id])
  classId   String?
  class     AcademicClass? @relation(fields: [classId], references: [id])
  period    Int // ১..৮
  label     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([branchId, classId, period]) // classId=null ডুপ DB-রোগ নয় — API findFirst দিয়ে আটকায়
  @@index([branchId])
}

// ─── 🖊️ মার্কস (৩.৬ — grade-স্ন্যাপশট; upsert=পুনঃএন্ট্রি-নিরাপদ; নোট ৪০) ───
model Mark {
  id            String      @id @default(cuid())
  branchId      String
  branch        Branch      @relation(fields: [branchId], references: [id])
  examId        String
  exam          Exam        @relation(fields: [examId], references: [id])
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  studentId     String
  student       User        @relation(fields: [studentId], references: [id])
  marksObtained Float
  grade         String?
  gradePoint    Float?
  enteredById   String
  enteredBy     User        @relation("MarkEnteredBy", fields: [enteredById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@unique([examSubjectId, studentId])
  @@index([branchId])
  @@index([examId])
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT
  LONG
}

model Question {
  id         String       @id @default(cuid())
  subjectId  String
  classId    String?
  type       QuestionType @default(MCQ)
  text       String
  options    Json?
  answer     String?
  marks      Float        @default(1)
  difficulty String       @default("MEDIUM")
  chapter    String?
  imageUrl   String?
  tags       String[]     @default([])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  subject Subject        @relation(fields: [subjectId], references: [id])
  class   AcademicClass? @relation(fields: [classId], references: [id])

  @@index([subjectId])
}

// ─── ৪.৪ অনলাইন এক্সাম ইঞ্জিন (নোট ৫৫: scalar-FK — পুরনো মডেল স্পর্শ নেই)
enum OnlineExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model OnlineExam {
  id          String           @id @default(cuid())
  branchId    String
  classId     String
  subjectId   String
  createdById String
  title       String
  durationMin Int              @default(30)
  startTime   DateTime
  endTime     DateTime
  randomize   Boolean          @default(true)
  status      OnlineExamStatus @default(DRAFT)
  examKind    String           @default("EXAM") // 🆕 M9: EXAM/QUIZ
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  questions OnlineExamQuestion[]
  attempts  ExamAttempt[]

  @@index([branchId, status])
}


model OnlineExamQuestion {
  id       String       @id @default(cuid())
  examId   String
  order    Int          @default(0)
  type     QuestionType
  text     String
  options  Json?
  answer   String?
  marks    Float        @default(1)
  imageUrl String?

  exam OnlineExam @relation(fields: [examId], references: [id])
}

model ExamAttempt {
  id            String    @id @default(cuid())
  examId        String
  studentId     String
  questionOrder String    @default("[]")
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  status        String    @default("IN_PROGRESS")
  totalMarks    Float     @default(0)
  obtainedMarks Float     @default(0)

  exam    OnlineExam   @relation(fields: [examId], references: [id]) // ← এই লাইনটাই ছিল না (P1012)
  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@index([studentId])
}

model ExamAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  examQuestionId String
  response       String?
  marksObtained  Float?

  attempt ExamAttempt @relation(fields: [attemptId], references: [id])

  @@unique([attemptId, examQuestionId])
}

// ─── ৪.৬ ফি-মডিউল (নোট ৫৫: scalar-FK অ্যাপেন্ড; রিলেশন-জুটি সব ব্লকের ভেতরে — ৫৫(ক))
model FeeStructure {
  id        String    @id @default(cuid())
  branchId  String
  classId   String
  name      String
  nameEn    String?
  amount    Float
  monthKey  String? // "2026-01" = মাসিক ফি; null = এককালীন
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoices FeeInvoice[]

  @@index([branchId])
  @@index([classId])
}

model FeeInvoice {
  id          String    @id @default(cuid())
  branchId    String
  structureId String
  studentId   String
  classId     String
  amount      Float
  dueDate     DateTime?
  status      String    @default("UNPAID") // UNPAID/PARTIAL/PAID
  paidTotal   Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  structure FeeStructure @relation(fields: [structureId], references: [id])
  payments  FeePayment[]

  @@unique([structureId, studentId])
  @@index([branchId])
  @@index([studentId])
  @@index([classId])
}

model FeePayment {
  id           String    @id @default(cuid())
  branchId     String
  invoiceId    String
  amount       Float
  method       String    @default("CASH") // CASH/BKASH/BANK/OTHER
  note         String?
  receivedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([branchId])
}

// ─── P2-DOC স্টুডেন্ট-ডকুমেন্ট + হেলথ-রেকর্ড (নোট ৫৫: scalar-FK অ্যাপেন্ড; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য)
model StudentDocument {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String
  title        String
  docType      String    @default("OTHER") // BIRTH_CERT/ACADEMIC/PHOTO/OTHER
  fileUrl      String
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId])
  @@index([studentId])
}

model HealthRecord {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String
  date         DateTime  @db.Date
  type         String // CHECKUP/VACCINATION/ILLNESS/INJURY/ALLERGY/OTHER
  title        String
  note         String?
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId])
  @@index([studentId])
}


// ─── M2: অনলাইন ভর্তি আবেদন (scalar-FK অ্যাপেন্ড — নোট ৫৫)
model AdmissionApplication {
  id                  String    @id @default(cuid())
  applicationNo       String    @unique
  branchId            String
  classId             String
  sectionId           String?
  sessionId           String?
  fullName            String
  email               String
  phone               String
  dateOfBirth         DateTime? @db.Date
  gender              String?
  fatherName          String?
  motherName          String?
  guardianPhone       String?
  address             String?
  previousInstitution String?
  photoUrl            String?
  status              String    @default("PENDING") // PENDING/APPROVED/REJECTED
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([branchId])
  @@index([status])
}


// ─── M3: PARENT-সন্তান লিংক (scalar-FK অ্যাপেন্ড — নোট ৫৫)
model ParentLink {
  id          String    @id @default(cuid())
  branchId    String
  parentId    String
  studentId   String
  relation    String? // FATHER/MOTHER/GUARDIAN/OTHER
  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@unique([parentId, studentId])
  @@index([branchId])
  @@index([studentId])
}

// ─── M6: QR হাজিরা-সেশন (scalar-FK অ্যাপেন্ড — নোট ৫৫)
model AttendanceQrSession {
  id          String   @id @default(cuid())
  branchId    String
  classId     String
  sectionId   String?
  date        DateTime @db.Date
  nonce       String   @unique
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([branchId, date])
  @@index([classId, date])
}

// ─── M7: অনলাইন-পেমেন্ট-ইনটেন্ট (৪.৭-B — scalar-FK অ্যাপেন্ড — নোট ৫৫)
model PaymentIntent {
  id            String    @id @default(cuid())
  branchId      String
  invoiceId     String
  studentId     String
  amount        Float
  tranId        String    @unique
  valId         String?
  gatewayTxnId  String?
  cardBrand     String?
  status        String    @default("PENDING") // PENDING/SUCCESS/FAILED
  initiatedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([branchId])
  @@index([invoiceId])
  @@index([status])
}


// ─── M10: অ্যাসাইনমেন্ট + সাবমিশন (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-জুটি ব্লকের-ভেতরেই)
model Assignment {
  id          String    @id @default(cuid())
  branchId    String
  classId     String
  subjectId   String
  createdById String
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Float     @default(10)
  fileUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  submissions AssignmentSubmission[]

  @@index([branchId])
  @@index([classId, dueDate])
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  branchId      String
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id])
  studentId     String
  fileUrl       String
  note          String?
  submittedAt   DateTime   @default(now())
  isLate        Boolean    @default(false)
  marksObtained Float?
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  @@unique([assignmentId, studentId])
  @@index([branchId])
  @@index([studentId])
}

// ─── M11: ডিসকাউন্ট/স্কলারশিপ + Income-Expense Ledger (scalar-FK অ্যাপেন্ড — নোট ৫৫; রিলেশন-নেই = পুরনো-স্পর্শ-শূন্য)
model StudentDiscount {
  id          String    @id @default(cuid())
  branchId    String
  studentId   String
  name        String
  type        String    @default("PERCENT") // PERCENT/AMOUNT
  value       Float
  isActive    Boolean   @default(true)
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId])
  @@index([studentId])
}

model LedgerEntry {
  id          String    @id @default(cuid())
  branchId    String
  type        String // INCOME/EXPENSE
  category    String
  amount      Float
  date        DateTime  @db.Date
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([branchId, type])
  @@index([branchId, date])
}
